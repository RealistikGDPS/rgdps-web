# The only component this image runs.
APP_COMPONENT=web

# Shown in titles and headings.
WEB_SITE_NAME=RealistikGDPS

# Send cookies over HTTPS only. Turn off for plain-HTTP local runs.
WEB_COOKIE_SECURE=true

# Cloudflare Turnstile keys for the registration form. Leave both empty to
# switch the captcha off, which is only sensible for local development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT_SECONDS=5

# The game server on the internal network, probed by the admin status page,
# and how often that page refreshes itself in the browser.
WEB_GAME_SERVER_URL=http://app:8000
WEB_GAME_SERVER_TIMEOUT_SECONDS=3
WEB_STATUS_POLL_SECONDS=10

# Directory holding the game's Resources/icons folder and the
# Robot_AnimDesc.plist and Spider_AnimDesc.plist files; read only. The
# quality picks which texture files are read: uhd, hd or sd.
WEB_ASSETS_PATH=/data/assets
WEB_ICON_QUALITY=uhd

# Rendered icons kept in memory per worker process.
WEB_ICON_CACHE_SIZE=4096
